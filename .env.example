# Application
APP_ENV=development
APP_LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# API and database
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=postgresql+psycopg://aim:aim@localhost:5432/aim
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Queue
REDIS_URL=redis://localhost:6379/0
SCAN_SCHEDULER_INTERVAL_SECONDS=60

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
ALERT_DELIVERY_BATCH_SIZE=25

# Scanner
SCANNER_TIMEOUT_SECONDS=10
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576
SSL_INSPECTION_TIMEOUT_SECONDS=10
LIGHTHOUSE_COMMAND=corepack pnpm exec lighthouse
LIGHTHOUSE_TIMEOUT_SECONDS=180

# AI diagnosis narrative
# Leave ANTHROPIC_API_KEY empty to use the deterministic report generator.
ANTHROPIC_API_KEY=

# AIM 자신의 장애(미처리 예외·태스크 실패)를 받을 운영자 webhook. 사용자 알림과 별개.
OPS_WEBHOOK_URL=

# /metrics 스크레이퍼용 토큰. 비우면 엔드포인트가 404로 닫힌다.
METRICS_TOKEN=

# 조사 에이전트 LLM 지출 상한(USD). 비우면 상한 없음. 넘으면 조사를 멈추지 않고
# 규칙 정책으로 강등한다 — 비용 때문에 장애 진단이 사라지는 쪽이 더 나쁘다.
AIM_AGENT_DAILY_BUDGET_USD=
AIM_AGENT_MONTHLY_BUDGET_USD=
# 모델별 백만 토큰당 단가 덮어쓰기: {"model": [input, output]}. 비우면 내장 표.
AIM_AGENT_MODEL_RATES_JSON=
AI_REPORT_MODEL=claude-opus-4-8
AI_REPORT_LLM_TIMEOUT_SECONDS=30
AI_REPORT_LLM_MAX_RETRIES=1
AI_REPORT_LLM_MAX_TOKENS=16000

# Artifact storage
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=artifacts
# 아티팩트 보존 기간(일). 베이스라인 검사의 근거는 기간과 무관하게 보존한다.
ARTIFACT_RETENTION_DAYS=14
# 실패·인시던트·조사가 걸린 검사의 근거는 더 오래 남긴다(기본값 이상이어야 함).
ARTIFACT_INCIDENT_RETENTION_DAYS=90
ARTIFACT_PURGE_BATCH_SIZE=500
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=aim
MINIO_SECRET_KEY=replace-with-a-local-development-secret
MINIO_BUCKET=aim-artifacts
