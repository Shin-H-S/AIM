# AIM production environment example for the production VM (Oracle Cloud A1) + Docker Compose.
# Copy this file to `.env.production` on the VM and replace every placeholder value.

# Application
APP_ENV=production
APP_LOG_LEVEL=INFO

# Public hostnames
# Use two DNS records that point to the VM static external IP.
AIM_WEB_HOSTNAME=aim.example.com
AIM_API_HOSTNAME=api.aim.example.com
# 조사 에이전트 도그푸딩 실험대(선택) — 설정하면 해당 호스트로 infra/lab 정적 페이지를 서빙한다.
# 비워 두면 lab.localhost로 떨어져 외부에 노출되지 않는다. 자세한 사용법은 infra/lab/README.md.
AIM_LAB_HOSTNAME=lab.aim.example.com

# Web
# NEXT_PUBLIC_API_URL is baked into the Next.js production build.
# Rebuild the web image after changing this value.
NEXT_PUBLIC_API_URL=https://api.aim.example.com

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=["https://aim.example.com"]
# 32자 이상이어야 하며 개발 기본값이면 API가 부팅을 거부한다(app_env != development).
# 생성: openssl rand -base64 48
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 세션 쿠키를 웹(qaaimsync.com)과 API(api.qaaimsync.com)가 공유하려면
# 부모 도메인이 필요하다. Secure는 https 전용 — 운영에서 반드시 켠다.
AUTH_COOKIE_DOMAIN=.qaaimsync.com
AUTH_COOKIE_SECURE=true

# PostgreSQL
POSTGRES_DB=aim
POSTGRES_USER=aim
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://aim:replace-with-a-strong-database-password@postgres:5432/aim

# Redis / Celery
REDIS_URL=redis://redis:6379/0
SCAN_SCHEDULER_INTERVAL_SECONDS=60
CELERY_WORKER_CONCURRENCY=1

# Email alerts
# Leave empty to record alerts without sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
ALERT_DELIVERY_BATCH_SIZE=25
# Slack/Discord webhook alerts (per-project URLs are stored in the DB).
ALERT_WEBHOOK_TIMEOUT_SECONDS=10

# Scanner
SCANNER_TIMEOUT_SECONDS=10
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576
SSL_INSPECTION_TIMEOUT_SECONDS=10
LIGHTHOUSE_COMMAND=lighthouse
LIGHTHOUSE_TIMEOUT_SECONDS=180

# AI diagnosis narrative
# Leave ANTHROPIC_API_KEY empty to use the deterministic report generator.
ANTHROPIC_API_KEY=

# AIM 자신의 장애(미처리 예외·태스크 실패)를 받을 운영자 webhook. 사용자 알림과 별개.
# VM 헬스 경보(monitor-vm-health.sh)와 같은 Discord webhook을 써도 된다.
OPS_WEBHOOK_URL=

# /metrics 스크레이퍼용 토큰. 비우면 엔드포인트가 404로 닫힌다.
# 생성: openssl rand -hex 32
METRICS_TOKEN=

# 조사 에이전트 LLM 지출 상한(USD). 비우면 상한 없음. 넘으면 조사를 멈추지 않고
# 규칙 정책으로 강등한다 — 비용 때문에 장애 진단이 사라지는 쪽이 더 나쁘다.
AIM_AGENT_DAILY_BUDGET_USD=
AIM_AGENT_MONTHLY_BUDGET_USD=
# 모델별 백만 토큰당 단가 덮어쓰기: {"model": [input, output]}. 비우면 내장 표.
AIM_AGENT_MODEL_RATES_JSON=
AI_REPORT_MODEL=claude-opus-4-8
AI_REPORT_LLM_TIMEOUT_SECONDS=30
AI_REPORT_LLM_MAX_RETRIES=1
AI_REPORT_LLM_MAX_TOKENS=16000

# Artifact storage
# Local artifact storage is the only implemented backend today.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=/data/aim/artifacts
# 아티팩트 보존 기간(일). 이 정리가 없으면 단일 VM 디스크가 언젠가 찬다.
# 베이스라인 검사의 근거는 기간과 무관하게 보존한다.
ARTIFACT_RETENTION_DAYS=14
# 실패·인시던트·조사가 걸린 검사의 근거는 더 오래 남긴다(기본값 이상이어야 함).
ARTIFACT_INCIDENT_RETENTION_DAYS=90
ARTIFACT_PURGE_BATCH_SIZE=500
